# HTTP server
PORT=3100
HOST=127.0.0.1

# Sent to Wikimedia APIs, which require a descriptive User-Agent with contact info
USER_AGENT=image-hunter-poc/0.1 (dev; contact: admin@example.com)

# Optional: Openverse bearer token (anonymous access works for the POC, with lower rate limits)
OPENVERSE_TOKEN=

# Optional: Europeana API key. Leave empty to use the public demo key (api2demo), which is rate-limited.
EUROPEANA_KEY=

# Stock sites need a free API key each. Without a key, that source reports "key missing" and is skipped.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
